# Copy to /etc/yive/relay.env and edit before installing yive-relay.service.
#
# Generate a strong token:
#   openssl rand -base64 32

YIVE_RELAY_PORT=4020
# Use 0.0.0.0 on a cloud server that should accept public traffic.
YIVE_RELAY_HOST=127.0.0.1
YIVE_RELAY_ADMIN_TOKEN=change-me
YIVE_RELAY_PAIRING_STORE=/var/lib/yive/relay-pairings.json
YIVE_RELAY_STATIC_DIR=/opt/yive-runtime/web/dist
YIVE_RELAY_HEARTBEAT_INTERVAL_MS=30000
YIVE_RELAY_HEARTBEAT_TIMEOUT_MS=75000
YIVE_RELAY_REQUIRE_DESKTOP_BINDING=1

# Optional but recommended. deploy-relay.sh and rollback-relay.sh run smoke-relay
# against this URL after restart when it is set.
YIVE_RELAY_PUBLIC_URL=http://<server-ip>:4020
