# Copy to a private path, for example:
#   C:\Users\<you>\.config\yive\desktop-relay.env
#
# This file is loaded by run-windows-desktop-relay.ps1.
# Keep it private because it contains the relay admin token used to connect this desktop.
# Before starting the supervisor, validate the config without launching processes:
#   powershell -NoProfile -ExecutionPolicy Bypass -File deploy\run-windows-desktop-relay.ps1 -Check
# The check contacts the Relay by default. For local-only config validation:
#   powershell -NoProfile -ExecutionPolicy Bypass -File deploy\run-windows-desktop-relay.ps1 -Check -SkipRelayCheck
# The check also verifies the local Yive runtime when this helper does not manage
# it. For config-only validation:
#   powershell -NoProfile -ExecutionPolicy Bypass -File deploy\run-windows-desktop-relay.ps1 -Check -SkipRelayCheck -SkipRuntimeCheck
# After the supervisor is running, verify runtime + Relay registration without
# opening a new long-lived socket. The default status file below is read
# automatically; pass --status-file only if you customize YIVE_RELAY_STATUS_FILE.
#   yive connect status --server https://relay.example.com --token <token> --device-id desktop-windows --runtime http://127.0.0.1:3001

YIVE_RELAY_SERVER=https://relay.example.com
YIVE_RELAY_TOKEN=change-me
YIVE_RELAY_DEVICE_ID=desktop-windows
YIVE_RUNTIME_PORT=3001
YIVE_RELAY_RUNTIME_URL=http://127.0.0.1:3001
# How long the desktop relay waits for each local runtime HTTP request before
# returning a clear error to the phone.
YIVE_RELAY_LOCAL_REQUEST_TIMEOUT_MS=15000
YIVE_MOBILE_URL=https://relay.example.com
YIVE_RELAY_STATUS_FILE=C:\Users\<you>\.config\yive\desktop-relay-status.json

# Default: connect to an already-running local Yive runtime.
# Set to 1 only when this relay helper should also start/restart the runtime.
YIVE_RELAY_MANAGE_RUNTIME=0
# Set to 1 only when you want `-Check` to skip probing the local runtime.
YIVE_RELAY_SKIP_RUNTIME_CHECK=0
# The Windows supervisor passes `--require-runtime` to yive connect so the
# desktop is not advertised as controllable when the local runtime is down.
